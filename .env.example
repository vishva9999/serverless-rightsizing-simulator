# ==============================================================================
# AI Disaster Evacuation & Resource Allocation Command Center
# Environment Configuration Template
# ==============================================================================

# System Mode Notice:
# All disaster, IoT sensor, and dispatch operations in this platform are SIMULATED.
IS_SIMULATION_MODE=true
EMERGENCY_SERVICES_INTEGRATED=false

# Application Settings
APP_NAME="AI Disaster Evacuation & Resource Allocation Command Center"
APP_ENV=development
API_V1_STR=/api/v1
LOG_LEVEL=INFO

# Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=command_admin
POSTGRES_PASSWORD=command_secure_password
POSTGRES_DB=disaster_command_db
# In local dev without PostgreSQL, SQLite fallback can be enabled via fallback logic
DATABASE_URL=postgresql://command_admin:command_secure_password@localhost:5432/disaster_command_db

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# WebSocket Configuration
WS_PING_INTERVAL_SECONDS=30

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000/ws
VITE_ENABLE_SIMULATION_BADGE=true
