# Environment configuration for Serverless Rightsizing Simulator Backend
# Copy this file to .env and update values as needed.

PROJECT_NAME="Serverless Cost & Performance Rightsizing Simulator"
VERSION="0.1.0"
ENVIRONMENT="development"

# Path to the synthetic metrics CSV (relative to backend/ directory)
DATA_FILE_PATH="../data/sample_serverless_metrics.csv"

# CORS allowed origin (React dev server or CloudFront URL)
CORS_ORIGIN="http://localhost:5173"

# --- Phase 4 AWS & Storage Settings ---
# STORAGE_MODE: 'local' (uses SQLite) or 'aws' (uses DynamoDB + S3)
STORAGE_MODE=local
AWS_REGION=ap-south-1
SCENARIOS_TABLE=serverless-rightsizing-scenarios
HISTORY_TABLE=serverless-rightsizing-history
S3_BUCKET=serverless-rightsizing-artifacts

# --- Phase 6 & 7 Authentication & RBAC Settings ---
# AUTH_MODE: 'local' (uses local JWT + SQLite) or 'cognito' (Amazon Cognito)
AUTH_MODE=local
JWT_SECRET_KEY=change-me-in-development-secret-key-32bytes
JWT_EXPIRE_MINUTES=60

# Amazon Cognito Configuration (Required when AUTH_MODE=cognito)
COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=ap-south-1

# DO NOT HARDCODE REAL ACCESS KEYS OR PRODUCTION JWT SECRETS HERE.
# Lambda uses its IAM execution role. Local CLI uses standard AWS credential profiles.
