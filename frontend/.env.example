# Environment configuration for Serverless Rightsizing Simulator Frontend (Vite)
# Copy this file to .env and adjust values for your target deployment.

# --- LOCAL DEVELOPMENT (Default) ---
VITE_AUTH_MODE=local
VITE_API_BASE_URL=http://127.0.0.1:8000

# --- AWS PRODUCTION (When deployed) ---
# VITE_AUTH_MODE=cognito
# VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com/Prod
# VITE_COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
# VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_COGNITO_REGION=ap-south-1

# NEVER PUT AWS SECRET ACCESS KEYS IN FRONTEND VITE ENVIRONMENT VARIABLES.
